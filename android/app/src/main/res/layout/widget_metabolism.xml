<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <!-- Top Bar: Title, Updated time & Refresh button -->
    <RelativeLayout
        android:id="@+id/widget_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_header_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_widget_coffee" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:letterSpacing="0.08"
                android:text="METABOLISM"
                android:textColor="@color/widget_text_muted"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_updated_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="12:07 AM"
                android:textColor="@color/widget_text_muted"
                android:textSize="9.5sp" />

            <ImageButton
                android:id="@+id/widget_refresh_btn"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/widget_refresh_background"
                android:contentDescription="Refresh"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_refresh" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Main Content: Active Level on Left, Compact Metrics (or Large Today Box) on Right -->
    <LinearLayout
        android:id="@+id/widget_metabolism_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left: Active Caffeine & Status Pill -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_active_mg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="0"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_active_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:includeFontPadding="false"
                    android:text="mg active"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/widget_pill_green"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="Sleep-Safe Now"
                android:textColor="@color/widget_status_green"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right Variant A: Compact Metrics Box (visible in compact/short mode when width >= 180dp) -->
        <LinearLayout
            android:id="@+id/widget_metrics_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_button_background"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp">

            <!-- Row 1: In 6h -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_in_6h_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="In 6h: "
                    android:textColor="@color/widget_text_muted"
                    android:textSize="8.5sp" />

                <TextView
                    android:id="@+id/widget_half_life_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="0 mg"
                    android:textColor="@color/widget_status_amber"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 2: Today / Limit -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_today_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="Today: "
                    android:textColor="@color/widget_text_muted"
                    android:textSize="8.5sp" />

                <TextView
                    android:id="@+id/widget_today_total_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="0 / 400 mg"
                    android:textColor="@color/widget_brand_accent"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 3: Clears in -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_clears_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="Clears: "
                    android:textColor="@color/widget_text_muted"
                    android:textSize="8.5sp" />

                <TextView
                    android:id="@+id/widget_clearance_notice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="0h"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Variant B: Today's Total Card (visible in large/tall mode) -->
        <LinearLayout
            android:id="@+id/widget_large_today_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_button_background"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_large_today_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="TODAY'S TOTAL"
                android:textColor="@color/widget_text_muted"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_large_today_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="0 mg"
                android:textColor="@color/widget_brand_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_large_today_limit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="Limit: 400 mg"
                android:textColor="@color/widget_text_muted"
                android:textSize="8.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Large Mode Section: 3-Milestone Journey Cards (visible when tall) -->
    <LinearLayout
        android:id="@+id/widget_milestones_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- Milestone 1: Active Now -->
        <LinearLayout
            android:id="@+id/widget_milestone_1_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">

            <TextView
                android:id="@+id/widget_milestone_1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="ACTIVE NOW"
                android:textColor="@color/widget_text_muted"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_milestone_1_mg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="0 mg"
                android:textColor="@color/widget_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_milestone_1_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="Peak"
                android:textColor="@color/widget_text_muted"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- Milestone 2: Half-Life (+6h) -->
        <LinearLayout
            android:id="@+id/widget_milestone_2_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">

            <TextView
                android:id="@+id/widget_milestone_2_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="IN 6 HOURS"
                android:textColor="@color/widget_text_muted"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_milestone_2_mg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="0 mg"
                android:textColor="@color/widget_status_amber"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_milestone_2_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="Half-Life"
                android:textColor="@color/widget_text_muted"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- Milestone 3: Sleep Safe (<50mg) -->
        <LinearLayout
            android:id="@+id/widget_milestone_3_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">

            <TextView
                android:id="@+id/widget_milestone_3_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="SLEEP SAFE"
                android:textColor="@color/widget_text_muted"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_milestone_3_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="--"
                android:textColor="@color/widget_status_green"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_milestone_3_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="&lt; 50 mg"
                android:textColor="@color/widget_text_muted"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Large Mode Section: Bottom Clearance ETA Footnote (visible when tall) -->
    <TextView
        android:id="@+id/widget_large_clearance_footnote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Clears to safe sleep level in ~0 hours"
        android:textColor="@color/widget_brand_accent"
        android:textSize="9.5sp"
        android:visibility="gone" />

</LinearLayout>
